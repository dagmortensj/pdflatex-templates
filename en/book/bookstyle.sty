\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bookstyle}[2026/09/04 v1.12 — frozen CUP-style book layout]

% ============================================================
% PACKAGE OPTIONS
%
%   \usepackage{bookstyle}            normal
%   \usepackage[proof]{bookstyle}     page proofs: the B5
%                                     page untouched, centred
%                                     on A4 with crop marks
%
% Proof mode requires b5paper in \documentclass. The
% typesetting is untouched, so both line and page breaks are
% identical to print — unlike the a4paper draft, which
% shares line breaks but not page breaks. With a4paper the
% option is ignored with a warning. 'korrektur' is accepted
% as a synonym.
% ============================================================
\newif\ifbk@korrektur
\DeclareOption{korrektur}{\bk@korrekturtrue}
\DeclareOption{proof}{\bk@korrekturtrue}
\ProcessOptions\relax


% ============================================================
% bookstyle.sty — a CUP-style monograph
%
% Every typographic decision lives in this file. You should
% not need to change anything here to write a book: set the
% paper size in main.tex and start writing.
%
%   \documentclass[11pt,twoside,b5paper]{book}   % print
%   \documentclass[11pt,twoside,a4paper]{book}   % draft
%
% Engine: pdfLaTeX. This is the pdflatex sibling of the book
% in lualatex-templates: the same layout, but with Latin
% Modern in place of the OpenType fonts, which need LuaLaTeX.
%
% The order below: language, vector arrows, fonts,
% microtypography, geometry, spacing, sectioning, page
% furniture, citations, and hyperref last.
% ============================================================


% ============================================================
% LANGUAGE
%
% babel is loaded here and not in main.tex, so that loading
% the style is enough to get hyphenation and punctuation
% right. Switch language on the line below.
% ============================================================
\RequirePackage[english]{babel}


% ============================================================
% NUMBERS & UNITS (siunitx)
%
% main.tex loads siunitx when a document needs \qty and
% \num; the style carries the language choices, so a
% document that loads the package gets English typesetting
% without configuring anything itself. The hook runs the
% moment siunitx is loaded -- before the rest of the
% preamble -- so a \sisetup in main.tex still overrides
% what is set here. Does nothing in a document that never
% loads siunitx.
%
% The choices follow NIST SP 811 and ISO 80000-1:
%   decimal point         6.63 (siunitx default)
%   multiplication cross  6.63 × 10^-34 -- not a half-high
%                         dot; ISO reserves the dot for the
%                         decimal-comma tradition (default)
%   "to" and "and"        \qtyrange: 10 km to 20 km,
%                         \qtylist: 1 V, 2 V and 3 V (default)
%   slash in units        m/s^2 -- not m s^-2; textbook,
%                         not journal
%   combined uncertainty  (9.81 ± 0.03) m/s^2
%
% The rest are siunitx defaults and should stay: thin space
% around the multiplication sign and between number and
% unit (as in Griffiths), digit grouping by thin space from
% five digits (10 000, but 1000), and a space before %.
% ============================================================
\AddToHook{package/siunitx/after}{%
  \sisetup{
    per-mode              = symbol,
    separate-uncertainty  = true,
  }%
}


% ============================================================
% VECTOR ARROWS
%
% \vv{F} gives a vector arrow over a single symbol. It is the
% font's own arrow (\vec): pdfLaTeX places it correctly on italic
% letters, and indices sit close, \vv{F}_1. Over several symbols,
% such as a line segment, write \overrightarrow{AB}.
% \vv*{F}{net} is the same as \vv{F}_{net}. No package is needed;
% esvect should not be loaded. The definition is set at
% \begin{document}, so it also wins in an older document that
% still loads esvect.
% ============================================================
\expandafter\chardef\csname vvfix@atcode\endcsname=\catcode`\@
\catcode`\@=11
\def\VV@star#1#2{\vec{#1}_{#2}}
\DeclareRobustCommand{\VV@vv}{\@ifstar\VV@star\vec}
\AtBeginDocument{\let\vv\VV@vv}
\catcode`\@=\vvfix@atcode


% ============================================================
% FONTS
%
% MLModern in T1 encoding. It is Computer Modern redrawn
% with a heavier stroke — the same call the lua templates
% make with NewComputerModern: plain Latin Modern goes thin
% in laser print. The metrics are identical to Latin
% Modern's, so line breaking and every derived number in
% this file stand untouched. T1 is not decoration: with the
% old OT1 encoding, accented letters are assembled from
% accent boxes, and hyphenation fails in words carrying
% them.
%
% The mathematics comes from the same family at the same
% size as the text. That is why there is no
% downscaling here, and no small equation tag the way the
% lua book has one: there the maths font is scaled to 0.90
% and the tag shrinks to match. Here the \normalfont tag is
% right as it is.
% ============================================================
\RequirePackage[T1]{fontenc}
\RequirePackage{mlmodern}


% ============================================================
% MICROTYPOGRAPHY
%
% protrusion hangs punctuation into the margin, expansion
% stretches glyphs by fractions of a percent to avoid loose
% lines, and tracking letterspaces the small caps. Switch
% any of the three off here if a page looks wrong.
% ============================================================
\RequirePackage[
  expansion=true,
  protrusion=true,
  tracking=true
]{microtype}


% ============================================================
% PAGE GEOMETRY
%
% MEASURE. Bringhurst measures line length in lowercase
% alphabets, and 1.8–2.4 is the usable window. Latin
% Modern's alphabet is 49.1mm at 11pt, so the 116mm below
% is 2.36 alphabets — exactly the measure the lua book
% lands on with Garamond at 12pt. The two books share their
% readability target, each with its own face.
%
% MARGINS. Outer wider than inner, deliberately: the two
% inner margins meet across the spine and read as one
% space, while the outer edge is where the thumb sits.
% 2.6cm inside still clears a glue binding, and the wide
% outer edge is where an oversized equation can hang out.
%
% It is the measure, not the margins, that stays fixed when
% the paper size changes: an A4 draft breaks lines exactly
% like the printed B5, with over 4cm left for notes. Page
% breaks still differ — A4 is taller.
% ============================================================
\RequirePackage{geometry}
\ifdim\paperwidth>18cm
  \geometry{inner=4.5cm, outer=4.9cm, top=2.6cm, bottom=3.9cm}
\else
  \geometry{inner=2.6cm, outer=3.4cm, top=2.6cm, bottom=3.9cm}
\fi

% Page proofs: the B5 sheet centred on A4 with crop marks
% (cam) and crop's info line at the top — add noinfo to the
% options below for a clean sheet. Loaded here, after the
% geometry is set.
\ifbk@korrektur
  \ifdim\paperwidth>18cm
    \PackageWarning{bookstyle}{The 'proof' option requires b5paper; option ignored}%
  \else
    \RequirePackage[cam,a4,center]{crop}
  \fi
\fi


% ============================================================
% PARAGRAPHS AND LEADING
%
% Indented paragraphs with no space between — the classical
% book page.
% ============================================================
\setlength{\parindent}{15pt}
\setlength{\parskip}{0pt}

% Latin Modern at 11pt has an x-height of 4.71pt — the same
% optical class as Garamond Libre at 12pt (4.88pt), so the
% two books read the same size even though the point sizes
% differ. The 1.07 stretch gives a 14.1pt baseline; the
% baseline-to-x-height ratio lands at 3.0 against the lua
% book's 3.03 — the page breathes alike in both.
\RequirePackage{setspace}
\setstretch{1.07}


% ============================================================
% DISPLAYED EQUATION SPACING
%
% Shared with the notes style, so the two read as a family.
%
%   above  12pt     after a short lead-in line   7pt
%   below  12pt     always                      12pt
%
% Only the space above shrinks after a short line, since a
% short line already leaves air of its own — and it never
% shrinks to zero. The space below is always full, so the
% gap under an equation never depends on what came before.
%
% \AtBeginDocument is not decoration. \begin{document} runs
% \normalsize, which resets all four skips to the class
% defaults, so values set in the preamble are silently
% discarded. Later size changes are grouped and restore
% these on exit.
% ============================================================
\AtBeginDocument{%
  \setlength{\abovedisplayskip}{12pt plus 3pt minus 3pt}%
  \setlength{\belowdisplayskip}{12pt plus 3pt minus 3pt}%
  \setlength{\abovedisplayshortskip}{7pt plus 3pt minus 3pt}%
  \setlength{\belowdisplayshortskip}{12pt plus 3pt minus 3pt}%
}

% ============================================================
% ROW SPACING IN ALIGN
%
% \jot is the extra space amsmath adds between the rows of
% align, gather and aligned. The default is 3 pt, which
% crowds the rows, especially when they hold display-style
% fractions. 8 pt gives the rows about the same breathing
% room as the space to the surrounding prose, without the
% chain falling apart into separate equations; 10 pt does.
% Where one block needs less, use \\[-2pt] locally.
%
% No \AtBeginDocument needed: \jot is an ordinary length that
% \normalsize leaves alone.
% ============================================================
\setlength{\jot}{8pt}


% ============================================================
% CAPTIONS
%
%   font=small       one step below body text
%   labelfont=bf     bold "Figure 1." label
%   labelsep=period  a period after the number, not a colon
%
% Single-line captions centre themselves; longer ones are
% justified. Both are caption's defaults.
% ============================================================
\RequirePackage[font=small,labelfont=bf,labelsep=period]{caption}


% ============================================================
% SECTIONING
%
% A chapter opens on its own page: "Chapter N" in small caps
% above the title in full caps. Sections and below are bold
% and upright, one size step apart. \chaptername and
% \partname come from babel and therefore follow the
% document language.
% ============================================================
\RequirePackage{titlesec}

% ------------------ Main chapters ----------------
\titleformat{\chapter}[display]
  {\normalfont}
  {\filcenter\scshape \chaptername\ \thechapter}
  {3ex}
  {\filcenter\Huge\MakeUppercase}

\titlespacing*{\chapter}
  {0pt}{3.5ex plus 1ex minus .2ex}{11ex plus 2ex minus .5ex}

% ------------------ Sections ---------------------
\titleformat{\section}
  {\normalfont\bfseries\large}
  {\thesection}{1em}{}

\titlespacing*{\section}
  {0pt}{2.5ex plus 1ex minus .2ex}{1.5ex plus .2ex}

% ------------------ Subsections ------------------
\titleformat{\subsection}
  {\normalfont\bfseries\normalsize}
  {\thesubsection}{1em}{}

\titlespacing*{\subsection}
  {0pt}{2ex plus .8ex minus .2ex}{1.2ex plus .2ex}


% ============================================================
% SECTION NUMBERING
%
% Parts and chapters are numbered; sections and below are
% not, but they still appear in the table of contents. Set
% secnumdepth to 2 if you want numbered sections.
% ============================================================
\setcounter{secnumdepth}{0}


% ============================================================
% PART PAGES
%
% A part title alone on an unnumbered page, set a third of
% the way down — the same rhythm as the chapter openings
% and the title page.
% ============================================================
\titleformat{\part}[display]
  {\normalfont}
  {\filcenter\scshape \partname\ \thepart}
  {3ex}
  {\filcenter\LARGE\MakeUppercase}

\titlespacing*{\part}
  {0pt}{0.35\textheight}{0.35\textheight}

\assignpagestyle{\part}{empty}


% ============================================================
% DROP CAP AT CHAPTER OPENINGS
%
%   \chapter{Chapter Title}
%   \chapteropening{T}{he first sentence}
%   continues here.
%
% Three lines deep, with the rest of the opening phrase in
% small caps. Nothing is injected automatically — a chapter
% without \chapteropening simply starts as ordinary text.
% Keep the opening paragraph long enough to fill the height
% of the drop cap, or the next heading collides with it.
% ============================================================
\RequirePackage{lettrine}

\newcommand{\chapteropening}[2]{%
  \lettrine[
    lines=3,
    loversize=0.0,
    lraise=0.0,
    findent=0.1em,
    nindent=0em
  ]{#1}{\textsc{#2}}%
}


% ============================================================
% TABLE OF CONTENTS
%
% No dot leaders and no frames: the page numbers sit
% against the right margin and the title is set like a
% chapter. Called with \booktoc.
% ============================================================
\RequirePackage{tocloft}

\renewcommand{\cfttoctitlefont}{\Huge\scshape}
\renewcommand{\cftaftertoctitle}{\par\vspace{2ex}}

\renewcommand{\cftchapleader}{\hfill}
\renewcommand{\cftsecleader}{\hfill}
\renewcommand{\cftsubsecleader}{\hfill}

\setlength{\cftchapnumwidth}{2.5em}
\setlength{\cftsecnumwidth}{3.0em}
\setlength{\cftsubsecnumwidth}{3.5em}

% Unnumbered sections otherwise start at tocloft's 1.5em —
% left of the chapter titles at 2.5em, so the children
% outdent past their parent. Line the sections up under the
% chapter title, and subsections one step further.
\setlength{\cftsecindent}{2.5em}
\setlength{\cftsubsecindent}{3.5em}

\setlength{\cftbeforechapskip}{6pt}
\setlength{\cftbeforesecskip}{2.5pt}
\setlength{\cftbeforesubsecskip}{1.5pt}

\newcommand{\booktoc}{%
  \tableofcontents
}


% ============================================================
% RUNNING HEADS AND PAGE STYLES
%
% Page numbers sit against the outer edge, the running
% chapter or section mark in the centre. Chapter-opening
% pages drop the head and get the page number centred at
% the foot instead. 'plain' is untouched, so the front
% matter is unaffected.
%
% Position codes in the definitions below:
%   L left, C centre, R right
%   E even page (verso), O odd page (recto)
% ============================================================
\RequirePackage{fancyhdr}
% 14pt instead of the class default: with Latin Modern's
% extenders at 11pt, fancyhdr wants at least 13.6pt and
% complains below that. 14pt is the first whole point above.
\setlength{\headheight}{14pt}

\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

% ------------------ Main matter pages -------------
\fancypagestyle{chapterstyle}{
  \fancyhf{}
  \fancyhead[LE]{\thepage}
  \fancyhead[CE]{\small\itshape\leftmark}
  \fancyhead[RO]{\thepage}
  \fancyhead[CO]{\small\itshape\rightmark}
}

% ------------------ Chapter opening pages ---------
\fancypagestyle{chapteropen}{
  \fancyhf{}
  \fancyfoot[C]{\thepage}
}

% ------------------ Front matter pages ------------
\fancypagestyle{frontmatterstyle}{
  \fancyhf{}
  \fancyhead[LE]{\thepage}
  \fancyhead[CE]{\small\itshape\leftmark}
  \fancyhead[RO]{\thepage}
  \fancyhead[CO]{\small\itshape\rightmark}
}

\fancypagestyle{frontmatteropen}{
  \fancyhf{}
  \fancyfoot[C]{\thepage}
}


% ============================================================
% PAGE STYLE FOR CHAPTER OPENINGS
%
% \chapter hardcodes \thispagestyle{plain} on the opening
% page. This patch redirects it to 'chapteropen' without
% touching 'plain' itself, which the front matter still
% uses.
% ============================================================
\RequirePackage{etoolbox}
\makeatletter

\patchcmd{\chapter}
  {\thispagestyle{plain}}
  {\thispagestyle{chapteropen}}
  {}{}

\makeatother


% ============================================================
% BLANK VERSO PAGES
%
% \cleardoublepage inserts a blank page to land on a recto,
% but the blank inherits the current page style and carries
% a running head and folio. The convention is that inserted
% blanks are completely empty. emptypage patches
% \cleardoublepage to do exactly that.
% ============================================================
\RequirePackage{emptypage}


% ============================================================
% FRONT MATTER CHAPTERS
%
%   \frontchapter{Preface}
%
% An unnumbered, flush-left heading one step smaller than a
% main chapter, for prefaces, acknowledgements and the
% like. It sets the running head itself, and that is what
% keeps "Chapter 0" from appearing. Start the first
% paragraph with \noindent.
% ============================================================
\makeatletter

\newcommand{\frontchapter}[1]{%
  \cleardoublepage
  \thispagestyle{frontmatteropen}

  % Set running header text (avoids "Chapter 0")
  \markboth{#1}{}

  % Heading block
  \vspace*{3ex}
  {\noindent\LARGE\bfseries #1\par}
  \vspace{3ex}
}

\makeatother


% ============================================================
% RUNNING HEADS
%
% Chapter title on the verso, section title on the recto,
% neither in capitals.
% ============================================================
\renewcommand{\chaptermark}[1]{\markboth{#1}{}}
\renewcommand{\sectionmark}[1]{\markright{#1}}

\pagestyle{chapterstyle}


% ============================================================
% TITLE PAGE
%
%   \title{...}  \author{...}  \date{...}
%   \subtitle{...}                 % optional
%   \booktitlepage
%
% The title in full-size small caps, an italic subtitle
% beneath it when set, the author below that, the date at
% the foot. Written out rather than built on \maketitle, so
% every space is visible here.
% ============================================================
\makeatletter

\def\@subtitle{}
\newcommand{\subtitle}[1]{\gdef\@subtitle{#1}}

\newcommand{\booktitlepage}{%
  \begin{titlepage}
    \thispagestyle{empty}

    \vspace*{0.18\textheight}

    \begin{center}
      {\Huge\scshape \@title \par}

      \ifx\@subtitle\@empty\else
        \vspace{1.6em}
        {\Large\itshape \@subtitle \par}
      \fi

      \vspace{3em}
      {\large \@author \par}
    \end{center}

    \vfill

    \begin{center}
      {\normalsize\itshape \@date \par}
    \end{center}
  \end{titlepage}
}

\makeatother


% ============================================================
% DEDICATION PAGE
%
%   \dedicationpage{To my parents.}
%
% One short italic line, centred a quarter of the way down
% a recto page, followed by an empty verso.
% ============================================================
\newcommand{\dedicationpage}[1]{%
  \cleardoublepage
  \thispagestyle{empty}
  \vspace*{0.25\textheight}
  \begin{center}
    \itshape #1
  \end{center}
  \vfill
  \cleardoublepage
}


% ============================================================
% CITATIONS
%
%   \cite{key}            superscript ¹
%   \cite{a,b,c}          sorted and compressed, ¹⁻³
%   \bibliography{...}    in the back matter of main.tex
%
% The 'nomove' option keeps a citation exactly where you
% wrote it instead of shifting it past punctuation, so put
% it right after the word it belongs to.
% ============================================================
\RequirePackage[superscript,nomove]{cite}

% Labels in the bibliography list: "1." instead of "[1]",
% to match the superscript style in the text.
\makeatletter
\renewcommand{\@biblabel}[1]{#1.}
\makeatother


% ============================================================
% HYPERLINKS
%
% Loaded last, because hyperref patches commands other
% packages define. The links are black rather than
% coloured, so the page prints exactly as it would without
% them, while they stay live in a PDF reader.
% ============================================================
\RequirePackage{xcolor}
\definecolor{linkblack}{RGB}{0,0,0}

\RequirePackage{hyperref}
\hypersetup{
  colorlinks=true,
  linkcolor=linkblack,
  citecolor=linkblack,
  urlcolor=linkblack,
  linktoc=page
}

% hyperref colours the page numbers in the table of
% contents by default; these three keep them black like
% everything else.
\makeatletter
\renewcommand{\cftchappagefont}{\normalfont\color{black}}
\renewcommand{\cftsecpagefont}{\normalfont\color{black}}
\renewcommand{\cftsubsecpagefont}{\normalfont\color{black}}
\makeatother


% ============================================================
% END OF FILE
% ============================================================
\endinput
