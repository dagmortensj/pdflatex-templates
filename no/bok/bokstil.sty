\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bokstil}[2026/09/04 v1.12 — frosset CUP-stil bokoppsett]

% ============================================================
% PAKKEOPSJONER
%
%   \usepackage{bokstil}              vanlig
%   \usepackage[korrektur]{bokstil}   sidekorrektur: B5-siden
%                                     uendret, sentrert på A4
%                                     med skjæremerker
%
% Korrekturmodusen krever b5paper i \documentclass. Satsen
% røres ikke, så både linje- og sidebrudd er identiske med
% trykk — i motsetning til a4paper-utkastet, som deler
% linjebrudd men ikke sidebrudd. Med a4paper ignoreres
% opsjonen med en advarsel. 'proof' godtas som synonym.
% ============================================================
\newif\ifbk@korrektur
\DeclareOption{korrektur}{\bk@korrekturtrue}
\DeclareOption{proof}{\bk@korrekturtrue}
\ProcessOptions\relax


% ============================================================
% bokstil.sty — en monografi i CUP-stil
%
% Alle typografiske valg bor i denne fila. Du skal ikke
% trenge å endre noe her for å skrive en bok: sett
% papirformatet i main.tex og begynn å skrive.
%
%   \documentclass[11pt,twoside,b5paper]{book}   % trykk
%   \documentclass[11pt,twoside,a4paper]{book}   % utkast
%
% Motor: pdfLaTeX. Dette er pdflatex-søsteren til boka i
% lualatex-templates: samme oppsett, men med Latin Modern
% i stedet for OpenType-fontene, som krever LuaLaTeX.
%
% Rekkefølgen nedenfor: språk, vektorpiler, fonter,
% mikrotypografi, geometri, avstander, seksjonering,
% sidemøblering, siteringer, og hyperref sist.
% ============================================================


% ============================================================
% SPRÅK
%
% babel lastes her og ikke i main.tex, slik at det å laste
% stilen er nok til å få orddeling og tegnsetting riktig.
% Bytt språk på linja under.
% ============================================================
\RequirePackage[norsk]{babel}


% ============================================================
% TALL OG ENHETER (siunitx)
%
% main.tex laster siunitx når et dokument trenger \qty og
% \num; stilen bærer språkvalgene, så et dokument som laster
% pakka får norsk sats uten å sette opp noe selv. Kroken
% kjører i det øyeblikket siunitx lastes -- før resten av
% preamble -- så en \sisetup i main.tex overstyrer fortsatt
% det som står her. Gjør ingenting i et dokument som aldri
% laster siunitx.
%
% Valgene følger Språkrådet og NS-ISO 80000-1:
%   desimalkomma          6,63 -- ikke 6.63
%   halvhøy prikk         6,63 · 10^-34 -- ikke kryss; ISO
%                         forbeholder krysset for
%                         desimalpunktum-tradisjonen
%   «til» og «og»         \qtyrange: 10 km til 20 km,
%                         \qtylist: 1 V, 2 V og 3 V
%   skråstrek i enheter   m/s^2 -- ikke m s^-2; lærebok,
%                         ikke tidsskrift
%   samlet usikkerhet     (9,81 ± 0,03) m/s^2
%
% Resten er siunitx sine standarder og skal stå: tynt
% mellomrom rundt gangetegnet og mellom tall og enhet (som
% hos Griffiths), tusenskille med tynt mellomrom fra fem
% sifre (10 000, men 1000), og mellomrom foran %.
% ============================================================
\AddToHook{package/siunitx/after}{%
  \sisetup{
    output-decimal-marker = {,},
    exponent-product      = \cdot,
    range-phrase          = { til },
    list-final-separator  = { og },
    list-pair-separator   = { og },
    per-mode              = symbol,
    separate-uncertainty  = true,
  }%
}


% ============================================================
% VEKTORPILER
%
% \vv{F} gir vektorpil over ett symbol. Det er fontens egen pil
% (\vec): pdfLaTeX plasserer den riktig på kursive bokstaver, og
% indekser står tett inntil, \vv{F}_1. Over flere symboler, som
% en strekning, skrives \overrightarrow{AB}. \vv*{F}{net} er det
% samme som \vv{F}_{net}. Ingen pakke trengs; esvect skal ikke
% lastes. Definisjonen settes ved \begin{document}, så den
% vinner også i et eldre dokument som fortsatt laster esvect.
% ============================================================
\expandafter\chardef\csname vvfix@atcode\endcsname=\catcode`\@
\catcode`\@=11
\def\VV@star#1#2{\vec{#1}_{#2}}
\DeclareRobustCommand{\VV@vv}{\@ifstar\VV@star\vec}
\AtBeginDocument{\let\vv\VV@vv}
\catcode`\@=\vvfix@atcode


% ============================================================
% FONTER
%
% MLModern i T1-koding. Det er Computer Modern tegnet med
% tykkere strek — samme valg som lua-malene gjør med
% NewComputerModern: vanlig Latin Modern blir tynn på
% laserutskrift. Metrikkene er identiske med Latin Moderns,
% så ombrekkingen og alle utledede tall i denne fila står
% urørt. T1 er ikke pynt: med den gamle OT1-kodingen settes
% æ, ø og å sammen av aksentbokser, og da virker ikke
% orddelingen i norske ord.
%
% Matematikken kommer fra samme familie i samme størrelse
% som teksten. Derfor finnes det ingen
% nedskalering her, og heller ingen liten ligningstagg slik
% lua-boka har: der er mattefonten skalert til 0,90 og
% taggen krympes til å matche. Her stemmer \normalfont-
% taggen som den er.
% ============================================================
\RequirePackage[T1]{fontenc}
\RequirePackage{mlmodern}


% ============================================================
% MIKROTYPOGRAFI
%
% protrusion henger tegnsetting ut i margen, expansion
% strekker glyffene brøkdeler av en prosent for å unngå løse
% linjer, og tracking sperrer kapitelene. Slå av hvilken som
% helst av de tre her hvis en side ser feil ut.
% ============================================================
\RequirePackage[
  expansion=true,
  protrusion=true,
  tracking=true
]{microtype}


% ============================================================
% SIDEGEOMETRI
%
% SATSBREDDE. Bringhurst måler linjelengde i lilleboks-
% alfabeter, og 1,8–2,4 er det brukbare vinduet. Latin
% Moderns alfabet er 49,1 mm ved 11 pt, så de 116 mm
% nedenfor er 2,36 alfabeter — nøyaktig samme mål som
% lua-boka lander på med Garamond ved 12 pt. De to bøkene
% deler altså lesbarhetsmål, med hver sin font.
%
% MARGER. Utside bredere enn innside, bevisst: de to
% innsidemargene møtes over ryggen og leses som ett rom,
% mens ytterkanten er der tommelen ligger. 2,6 cm innside
% klarer likevel en limbinding, og den brede ytterkanten er
% der en overdimensjonert ligning kan henge ut.
%
% Det er satsbredden, ikke margene, som holdes fast når
% papirformatet endres: et A4-utkast brekker linjer nøyaktig
% som den trykte B5-en, med over 4 cm igjen til notater.
% Sidebrudd blir likevel ulike — A4 er høyere.
% ============================================================
\RequirePackage{geometry}
\ifdim\paperwidth>18cm
  \geometry{inner=4.5cm, outer=4.9cm, top=2.6cm, bottom=3.9cm}
\else
  \geometry{inner=2.6cm, outer=3.4cm, top=2.6cm, bottom=3.9cm}
\fi

% Sidekorrektur: B5-arket sentrert på A4 med skjæremerker
% (cam) og crops informasjonslinje øverst — legg til noinfo
% i opsjonene under om du vil ha arket uten den. Lastes her,
% etter at geometrien er satt.
\ifbk@korrektur
  \ifdim\paperwidth>18cm
    \PackageWarning{bokstil}{Opsjonen 'korrektur' krever b5paper; opsjonen ignoreres}%
  \else
    \RequirePackage[cam,a4,center]{crop}
  \fi
\fi


% ============================================================
% AVSNITT OG KJEGLE
%
% Innrykkede avsnitt uten luft mellom — den klassiske
% boksatsen.
% ============================================================
\setlength{\parindent}{15pt}
\setlength{\parskip}{0pt}

% Latin Modern ved 11 pt har x-høyde 4,71 pt — samme optiske
% klasse som Garamond Libre ved 12 pt (4,88 pt), så de to
% bøkene leser like store selv om punktstørrelsene er ulike.
% Strekket 1,07 gir 14,1 pt kjegle; forholdet kjegle/x-høyde
% blir 3,0 mot lua-bokas 3,03 — siden puster likt i begge.
\RequirePackage{setspace}
\setstretch{1.07}


% ============================================================
% AVSTAND RUNDT VISTE LIGNINGER
%
% Delt med notatstilen, så de to leses som en familie.
%
%   over   12pt     etter en kort innledende linje   7pt
%   under  12pt     alltid                          12pt
%
% Bare avstanden over krymper etter en kort linje, siden en
% kort linje allerede gir luft av seg selv — og den krymper
% aldri til null. Avstanden under er alltid full, så luften
% under en ligning avhenger aldri av hva som kom før.
%
% \AtBeginDocument er ikke pynt. \begin{document} kjører
% \normalsize, som nullstiller alle fire skipene til
% klassens standard, så verdier satt i preamblet blir stille
% forkastet. Senere størrelsesendringer er grupperte og
% gjenoppretter disse når de avsluttes.
% ============================================================
\AtBeginDocument{%
  \setlength{\abovedisplayskip}{12pt plus 3pt minus 3pt}%
  \setlength{\belowdisplayskip}{12pt plus 3pt minus 3pt}%
  \setlength{\abovedisplayshortskip}{7pt plus 3pt minus 3pt}%
  \setlength{\belowdisplayshortskip}{12pt plus 3pt minus 3pt}%
}

% ============================================================
% AVSTAND MELLOM RADENE I ALIGN
%
% \jot er den ekstra luften amsmath legger mellom radene i
% align, gather og aligned. Standard er 3 pt, som klemmer
% radene sammen, særlig når de inneholder display-brøker.
% 8 pt gir radene omtrent samme pust som avstanden til
% prosaen rundt, uten at kjeden faller fra hverandre i
% separate ligninger; 10 pt gjør det. Trenger én blokk
% mindre, bruk \\[-2pt] lokalt.
%
% Trenger ikke \AtBeginDocument: \jot er en vanlig lengde som
% \normalsize ikke rører.
% ============================================================
\setlength{\jot}{8pt}


% ============================================================
% FIGURTEKSTER
%
%   font=small       ett steg under kroppsteksten
%   labelfont=bf     fet «Figur 1.»-etikett
%   labelsep=period  punktum etter nummeret, ikke kolon
%
% Figurtekster på én linje sentrerer seg selv; lengre tekst
% blir justert. Begge deler er caption sin standard.
% ============================================================
\RequirePackage[font=small,labelfont=bf,labelsep=period]{caption}


% ============================================================
% SEKSJONERING
%
% Et kapittel åpner på en egen side: «Kapittel N» i kapiteler
% over tittelen i store versaler. Seksjoner og nedover er
% fete og oppreiste, med ett størrelsessteg mellom.
% \chaptername og \partname kommer fra babel og følger
% derfor dokumentspråket.
% ============================================================
\RequirePackage{titlesec}

% ------------------ Hovedkapitler ----------------
\titleformat{\chapter}[display]
  {\normalfont}
  {\filcenter\scshape \chaptername\ \thechapter}
  {3ex}
  {\filcenter\Huge\MakeUppercase}

\titlespacing*{\chapter}
  {0pt}{3.5ex plus 1ex minus .2ex}{11ex plus 2ex minus .5ex}

% ------------------ Seksjoner --------------------
\titleformat{\section}
  {\normalfont\bfseries\large}
  {\thesection}{1em}{}

\titlespacing*{\section}
  {0pt}{2.5ex plus 1ex minus .2ex}{1.5ex plus .2ex}

% ------------------ Underseksjoner ---------------
\titleformat{\subsection}
  {\normalfont\bfseries\normalsize}
  {\thesubsection}{1em}{}

\titlespacing*{\subsection}
  {0pt}{2ex plus .8ex minus .2ex}{1.2ex plus .2ex}


% ============================================================
% SEKSJONSNUMMERERING
%
% Deler og kapitler er nummererte; seksjoner og nedover er
% det ikke, men de står fortsatt i innholdsfortegnelsen.
% Sett secnumdepth til 2 om du vil ha nummererte seksjoner.
% ============================================================
\setcounter{secnumdepth}{0}


% ============================================================
% DELSIDER
%
% En deltittel alene på en unummerert side, satt en
% tredjedel ned — samme rytme som kapittelåpningene og
% tittelsiden.
% ============================================================
\titleformat{\part}[display]
  {\normalfont}
  {\filcenter\scshape \partname\ \thepart}
  {3ex}
  {\filcenter\LARGE\MakeUppercase}

\titlespacing*{\part}
  {0pt}{0.35\textheight}{0.35\textheight}

\assignpagestyle{\part}{empty}


% ============================================================
% INITIAL VED KAPITTELÅPNING
%
%   \chapter{Kapitteltittel}
%   \chapteropening{D}{en første setningen}
%   fortsetter her.
%
% Tre linjer dyp, med resten av åpningsfrasen i kapiteler.
% Ingenting settes inn automatisk — et kapittel uten
% \chapteropening starter bare som vanlig tekst. Hold
% åpningsavsnittet langt nok til å fylle høyden av
% initialen, ellers krasjer neste overskrift med den.
% ============================================================
\RequirePackage{lettrine}

\newcommand{\chapteropening}[2]{%
  \lettrine[
    lines=3,
    loversize=0.0,
    lraise=0.0,
    findent=0.1em,
    nindent=0em
  ]{#1}{\textsc{#2}}%
}


% ============================================================
% INNHOLDSFORTEGNELSE
%
% Ingen punktledere og ingen rammer: sidetallene står mot
% høyre marg og tittelen er satt som et kapittel. Kalles med
% \booktoc.
% ============================================================
\RequirePackage{tocloft}

\renewcommand{\cfttoctitlefont}{\Huge\scshape}
\renewcommand{\cftaftertoctitle}{\par\vspace{2ex}}

\renewcommand{\cftchapleader}{\hfill}
\renewcommand{\cftsecleader}{\hfill}
\renewcommand{\cftsubsecleader}{\hfill}

\setlength{\cftchapnumwidth}{2.5em}
\setlength{\cftsecnumwidth}{3.0em}
\setlength{\cftsubsecnumwidth}{3.5em}

% Unummererte seksjoner starter ellers ved tocloft sine
% 1,5 em — til venstre for kapitteltitlene ved 2,5 em, så
% barna rykker ut forbi forelderen. Still seksjonene under
% kapitteltittelen, og underseksjoner ett steg til.
\setlength{\cftsecindent}{2.5em}
\setlength{\cftsubsecindent}{3.5em}

\setlength{\cftbeforechapskip}{6pt}
\setlength{\cftbeforesecskip}{2.5pt}
\setlength{\cftbeforesubsecskip}{1.5pt}

\newcommand{\booktoc}{%
  \tableofcontents
}


% ============================================================
% TOPPTEKST OG SIDESTILER
%
% Sidetallene står mot ytterkanten, det løpende kapittel-
% eller seksjonsmerket i midten. Kapittelåpningssider dropper
% toppteksten og får sidetallet sentrert nederst i stedet.
% 'plain' er urørt, så frontmaterialet er upåvirket.
%
% Posisjonskoder i definisjonene nedenfor:
%   L venstre, C midten, R høyre
%   E partallsside (verso), O oddetallsside (recto)
% ============================================================
\RequirePackage{fancyhdr}
% 14pt i stedet for klassens standard: med Latin Moderns
% overlengder på 11 pt vil fancyhdr ha minst 13,6 pt og
% klager under det. 14pt er første hele punkt over.
\setlength{\headheight}{14pt}

\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

% ------------------ Hovedmaterialesider -----------
\fancypagestyle{chapterstyle}{
  \fancyhf{}
  \fancyhead[LE]{\thepage}
  \fancyhead[CE]{\small\itshape\leftmark}
  \fancyhead[RO]{\thepage}
  \fancyhead[CO]{\small\itshape\rightmark}
}

% ------------------ Kapittelåpningssider ----------
\fancypagestyle{chapteropen}{
  \fancyhf{}
  \fancyfoot[C]{\thepage}
}

% ------------------ Frontmaterialesider -----------
\fancypagestyle{frontmatterstyle}{
  \fancyhf{}
  \fancyhead[LE]{\thepage}
  \fancyhead[CE]{\small\itshape\leftmark}
  \fancyhead[RO]{\thepage}
  \fancyhead[CO]{\small\itshape\rightmark}
}

\fancypagestyle{frontmatteropen}{
  \fancyhf{}
  \fancyfoot[C]{\thepage}
}


% ============================================================
% SIDESTIL FOR KAPITTELÅPNINGER
%
% \chapter hardkoder \thispagestyle{plain} på åpningssiden.
% Denne patchen omdirigerer den til 'chapteropen' uten å
% røre 'plain' selv, som frontmaterialet fortsatt bruker.
% ============================================================
\RequirePackage{etoolbox}
\makeatletter

\patchcmd{\chapter}
  {\thispagestyle{plain}}
  {\thispagestyle{chapteropen}}
  {}{}

\makeatother


% ============================================================
% BLANKE VERSOSIDER
%
% \cleardoublepage skyter inn en tomside for å lande på en
% recto, men tomsiden arver gjeldende sidestil og får
% topptekst og folio. Konvensjonen er at innskutte
% blanksider er helt tomme. emptypage patcher
% \cleardoublepage til nettopp det.
% ============================================================
\RequirePackage{emptypage}


% ============================================================
% FRONTMATERIALE-KAPITLER
%
%   \frontchapter{Forord}
%
% En unummerert, venstrejustert overskrift ett steg mindre
% enn et hovedkapittel, til forord, takk og lignende. Den
% setter toppteksten selv, og det er dét som hindrer at
% «Kapittel 0» dukker opp. Start første avsnitt med
% \noindent.
% ============================================================
\makeatletter

\newcommand{\frontchapter}[1]{%
  \cleardoublepage
  \thispagestyle{frontmatteropen}

  % Sett løpende topptekst (unngår "Kapittel 0")
  \markboth{#1}{}

  % Overskriftsblokk
  \vspace*{3ex}
  {\noindent\LARGE\bfseries #1\par}
  \vspace{3ex}
}

\makeatother


% ============================================================
% LØPENDE TOPPTEKST
%
% Kapitteltittel på verso, seksjonstittel på recto, ingen av
% dem i versaler.
% ============================================================
\renewcommand{\chaptermark}[1]{\markboth{#1}{}}
\renewcommand{\sectionmark}[1]{\markright{#1}}

\pagestyle{chapterstyle}


% ============================================================
% TITTELSIDE
%
%   \title{...}  \author{...}  \date{...}
%   \subtitle{...}                 % valgfritt
%   \booktitlepage
%
% Tittel i store kapiteler, en kursiv undertittel under om
% den er satt, forfatter under der igjen, dato nederst.
% Skrevet ut i stedet for bygget på \maketitle, slik at hver
% avstand er synlig her.
% ============================================================
\makeatletter

\def\@subtitle{}
\newcommand{\subtitle}[1]{\gdef\@subtitle{#1}}

\newcommand{\booktitlepage}{%
  \begin{titlepage}
    \thispagestyle{empty}

    \vspace*{0.18\textheight}

    \begin{center}
      {\Huge\scshape \@title \par}

      \ifx\@subtitle\@empty\else
        \vspace{1.6em}
        {\Large\itshape \@subtitle \par}
      \fi

      \vspace{3em}
      {\large \@author \par}
    \end{center}

    \vfill

    \begin{center}
      {\normalsize\itshape \@date \par}
    \end{center}
  \end{titlepage}
}

\makeatother


% ============================================================
% DEDIKASJONSSIDE
%
%   \dedicationpage{Til mine foreldre.}
%
% Én kort kursiv linje, sentrert en fjerdedel ned på en
% recto-side, fulgt av en tom verso.
% ============================================================
\newcommand{\dedicationpage}[1]{%
  \cleardoublepage
  \thispagestyle{empty}
  \vspace*{0.25\textheight}
  \begin{center}
    \itshape #1
  \end{center}
  \vfill
  \cleardoublepage
}


% ============================================================
% SITERINGER
%
%   \cite{nokkel}         superskript ¹
%   \cite{a,b,c}          sortert og komprimert, ¹⁻³
%   \bibliography{...}    i bakmaterialet i main.tex
%
% Opsjonen 'nomove' holder en sitering nøyaktig der du
% skrev den i stedet for å flytte den forbi tegnsetting,
% så sett den rett etter ordet den hører til.
% ============================================================
\RequirePackage[superscript,nomove]{cite}

% Etiketter i bibliografilisten: "1." istedenfor "[1]",
% for å matche superskript-stilen i teksten.
\makeatletter
\renewcommand{\@biblabel}[1]{#1.}
\makeatother


% ============================================================
% HYPERLENKER
%
% Lastes sist, fordi hyperref patcher kommandoer andre
% pakker definerer. Lenkene er svarte og ikke fargede, så
% siden trykkes nøyaktig som den ville gjort uten dem, mens
% de fortsatt er aktive i en PDF-leser.
% ============================================================
\RequirePackage{xcolor}
\definecolor{linkblack}{RGB}{0,0,0}

\RequirePackage{hyperref}
\hypersetup{
  colorlinks=true,
  linkcolor=linkblack,
  citecolor=linkblack,
  urlcolor=linkblack,
  linktoc=page
}

% hyperref fargelegger sidetall i innholdsfortegnelsen som
% standard; disse tre holder dem svarte som alt annet.
\makeatletter
\renewcommand{\cftchappagefont}{\normalfont\color{black}}
\renewcommand{\cftsecpagefont}{\normalfont\color{black}}
\renewcommand{\cftsubsecpagefont}{\normalfont\color{black}}
\makeatother


% ============================================================
% SLUTT PÅ FIL
% ============================================================
\endinput
